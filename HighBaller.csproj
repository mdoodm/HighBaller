<Project Sdk="Microsoft.NET.Sdk">
    <!--
      Stable build for Schedule I 0.4.7f12.
      References come from the local game install (MelonLoader-generated Il2Cpp
      assemblies) instead of third-party RefGen NuGet packages. No post-build
      script runs; deploy by copying the DLL into the game's Mods folder.
      Override the game path with: dotnet build -p:GameDir="/path/to/Schedule I"
    -->
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>HighBaller</RootNamespace>
        <Version>2.7.12</Version>
        <Authors>zocke18r, SFox, Virtunerd, k0Mods</Authors>
        <Description>Deal optimizer, auto counter offer, auto deal completion</Description>
        <Configurations>IL2CPP;Mono</Configurations>
        <Configuration Condition="'$(Configuration)' == ''">IL2CPP</Configuration>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Schedule I</GameDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Mono'">
        <DefineConstants>$(DefineConstants);MONO</DefineConstants>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>HighBaller-Mono</AssemblyName>
        <ManagedDir>$(GameDir)/Schedule I_Data/Managed</ManagedDir>
        <MLDir>$(GameDir)/MelonLoader/net35</MLDir>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'IL2CPP'">
        <TargetFramework>net6.0</TargetFramework>
        <AssemblyName>HighBaller-IL2CPP</AssemblyName>
        <ManagedDir>$(GameDir)/MelonLoader/Il2CppAssemblies</ManagedDir>
        <MLDir>$(GameDir)/MelonLoader/net6</MLDir>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="$(MLDir)/MelonLoader.dll" Private="false" />
        <Reference Include="$(MLDir)/0Harmony.dll" Private="false" />
        <Reference Include="$(ManagedDir)/*.dll" Exclude="$(ManagedDir)/netstandard.dll;$(ManagedDir)/mscorlib.dll;$(ManagedDir)/System*.dll;$(ManagedDir)/Mono.*.dll" Private="false" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Mono'">
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <Publicize Include="Assembly-CSharp" />
        <Publicize Include="ScheduleOne.Core" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'IL2CPP'">
        <Reference Include="$(MLDir)/Il2CppInterop.Runtime.dll" Private="false" />
        <Reference Include="$(MLDir)/Il2CppInterop.Common.dll" Private="false" />
    </ItemGroup>
</Project>
